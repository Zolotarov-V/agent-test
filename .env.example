# Front-end (Vercel) — recommended: leave unset so the app uses /api via vercel.json proxy
# Or set exactly once (never /api/api):
# VITE_API_URL=https://agent-test-idwz.onrender.com/api
#
# Local dev: omit VITE_API_URL (defaults to http://127.0.0.1:8000/api via vite proxy)

# Back-end (Render) — https://agent-test-idwz.onrender.com
# Allow browser requests from your Vercel app:
# CORS_ALLOWED_ORIGINS=https://agent-test-orcin.vercel.app,http://localhost:5173
# SECRET_KEY=change-me-in-production
# DEBUG=false

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_ITER=20

# Tool approval
AUTO_APPROVE_TOOLS=false
APPROVAL_TIMEOUT_SEC=300

# Chat uploads (optional overrides)
# AGENT_SUPPORTED_EXTENSIONS=txt,md,docx,xlsx,csv,pdf,json,js,jsx,ts,tsx,py,html,css,yaml,yml,xml
# AGENT_UPLOAD_MAX_BYTES=10485760

